/**
 * 감상 한 건이 글에 실릴 자격이 있는지 본다.
 *
 * 26.09.05에 112건을 통독하며 걸러야 할 두 부류를 알았다.
 *
 *  1. **본인이 말한 근거가 없는 것.** 「톰 크루즈는 드 니로에게 영향을 받았다」처럼
 *     서술자의 해석만 있고 당사자의 행위가 없다. 「누가 꼽았나」라는 이 채널의 전제를
 *     무너뜨린다.
 *  2. **감상이 아닌 것.** 편집자 주석이나 제3자의 작품 비교가 감상 자리에 들어와 있다.
 *     규칙으로 못 거르므로 `NOT_A_REVIEW` 에 id 로 적는다.
 *
 * 다만 그물이 과하면 좋은 것까지 걷는다. 처음 만든 판이 타란티노의 팟캐스트 발언과
 * 박찬욱의 상영회 회고를 떨어뜨렸다 — 「선정한」·「10위」·「상영에서 봤다」가 신호에
 * 없었기 때문이다. 그래서 **당사자의 행위**를 넓게 잡고, 인용부호가 들어 있으면 그
 * 자체를 근거로 인정한다.
 *
 * 판정은 기계적이라 완벽하지 않다. 원고를 올리기 전에 사람이 통독하는 절차
 * (`_dump-reviews.mts`)를 대체하지 않는다. 이 필터는 그 부담을 줄이는 그물이다.
 */

/** 당사자가 그 작품을 고르거나 말했다는 신호 */
const SAID = new RegExp([
  // 말하기
  '말했', '말한', '밝혔', '밝힌', '적었', '답했', '평했', '평가', '언급', '강조', '덧붙',
  '시인', '인정', '털어놓', '불렀', '부른다', '짚었', '전했', '썼다', '고백', '설명',
  '주장', '묘사', '극찬', '단언', '아쉬워', '물었', '증언', '감탄', '회상', '회고',
  // 고르기
  '꼽았', '꼽는', '꼽으', '꼽힌', '올렸', '골랐', '선택', '선정', '포함', '등재', '지목',
  '뽑았', '삼았', '추천', '순위', '위에 올', '\\d+위',
  // 본 경험을 1인칭·3인칭으로 남긴 것
  '봤다', '보았다', '관람', '다시 보', '반복해 보', '처음 접했', '처음 봤', '빠져',
  /**
   * 🔴 26.09.05 「귀속없음」 87건을 통독하며 채운 구멍이다. 아래 동사가 없어서 백악관 상영
   *    기록(아이젠하워 『하이 눈』)과 사이트 앤 사운드 감독 투표(우디 앨런 네 편)와 시사회
   *    참석 사진(J. 폴 게티 세 편)이 통째로 떨어지고 있었다. **신호가 좁으면 좋은 것이 먼저
   *    걸린다.**
   */
  '시청', '감상', '꼽은', '꼽아', '넣었', '담았', '참석', '본 뒤', '보고 ', '보며',
  '본 적', '들었', '댔다', '따왔', '따와', '가져왔', '소장',
].join('|'))

/** 큰따옴표·낫표 안의 발언은 그 자체로 근거다 */
const QUOTED = /["“”][^"“”]{12,}["“”]|'[^']{12,}'/

/**
 * 🔴 **손으로 걷어 낸 기록.**
 *
 * 아래 신호로는 잡히지 않는데 감상 기록이 아닌 것들이다. 「박찬욱의 데뷔작에서 세이준의
 * 영향을 읽을 수 있게 한다」처럼 화자가 아니라 **제3자가 두 작품을 견준 글**이거나,
 * 「작품을 특정한 기록은 없으며 대표작을 놓는다」처럼 **편집자 주석이 본문에 들어간 것**
 * 이다. 규칙으로 일반화하면 멀쩡한 것까지 걷으므로 id 로 지목한다.
 */
export const NOT_A_REVIEW = new Set([
  'c55d727a-e5ba-4e2c-979f-bc8c8ccfd82e', // 박찬욱 살인의 낙인 — 3자의 영향 관계 서술
  'fb91c41b-789b-419f-8619-3ed19c4e7ef0', // 리처드 닉슨 닥터 지바고 — 취향 추정
  '536ef946-7243-42ed-9a66-51cec77bcbc5', // 리들리 스콧 배리 린든 — 3자 해설
  '1bafda8e-1192-4205-bffe-4ffd93c138fc', // 질 들뢰즈 8과 1/2 — 저작 소개일 뿐 감상이 아니다
  '9760041f-35df-42aa-a9c7-1208947103b5', // 잭 킹 스타워즈 4 — 「작품을 특정하지 않아」 편집자 주
  'a0c436b8-d3c5-463e-83ad-7d3c976f98fe', // 잭 킹 왕의 귀환 — 같은 이유
  'e906fee1-1f79-4215-a908-ac3a7c191757', // 이은결 달세계 여행 — 같은 이유
  // 26.09.05 「귀속없음」 87건 통독분
  '0129870a-e781-4998-b257-0849e79660a0', // 다프트 펑크 자브리스키 포인트 — 3자의 영향 서술
  '1df18331-4158-43a3-a058-7558db2ce6cb', // 데이비드 보위 엘리펀트 맨 — 출연 이력이지 감상이 아니다
  '24dae0f0-ebce-4a90-8027-3e0d14497fdf', // 패트릭 스튜어트 몬티 파이튼의 성배 — 친분과 대역 발표
  '4b84eb17-39a7-4890-83c4-28dc7cce37f8', // 비비안 리 해밀턴 부인 — 실은 처칠의 감상이다
  '2e3b2292-47c9-41cf-b0df-557134994b1f', // 톰 크루즈 분노의 주먹 — 일반 영향론
  'e2538b39-9491-47ca-bddb-c458825584b8', // 톰 크루즈 대부 — 드 니로 소개
  '4bd66e02-8cbf-49c9-ad8e-ef40533602d2', // 질 들뢰즈 시민 케인 — 저작 소개
  '4e06b7e2-e5c2-49cc-a682-e04c90b0b802', // 리들리 스콧 It! — 「알려져 있다」
  '54c5f216-045c-400f-b3db-f8e038567b7e', // 리들리 스콧 아라비아의 로렌스 — 3자 서술
  '69d5a486-2609-476a-b65f-c47805bddfd7', // 데이비드 핀처 블레이드 러너 — 영향 서술
  'b10e812e-c1b5-4761-b2cb-eb9db7e720a0', // 마릴린 맨슨 스윙 재즈 — 해석
  'eae5d364-da34-4a72-9eaf-8e4ee18647f4', // 마릴린 맨슨 비엔나 호텔의 야간 배달부 — 해석
  'faf09886-cd95-44b2-b2a4-13c4cdbf2032', // 프린스 이레이저 헤드 — 해석
  'b695ffb0-6ed0-4fae-8f6f-e60504131e48', // 프린스 콰드로페니아 — 해석
  '793a4334-3988-464b-be12-dc88bdbebddf', // 밥 딜런 네 멋대로 해라 — 해석
  '2aa8a32c-24b5-47ad-9774-0b03ad498792', // 에르도안 Dirilis: Ertugrul — 드라마이고 정치 논평이다
])

/**
 * 🔴 **출처 표기는 더 이상 요구하지 않는다(26.09.05).**
 *
 * 처음에는 「언제 어디서」가 있어야 통과시켰다. 그물이 과했다. 그 조건 하나로 356건이
 * 떨어졌는데, 전부 읽어 보니 존 그린의 팟캐스트 발언이나 이명세의 영화 월드컵 코멘터리
 * 처럼 **화자가 분명히 말했는데 연도와 매체 이름이 문장에 안 적힌 것**이 대부분이었다.
 * 반대로 그 조건은 「1998년 개봉한 이 영화는 …」 같은 문장도 출처로 오인했다.
 *
 * 그래서 356건을 통독해 근거 없는 꼬리를 DB에서 걷고(`fix-db.mts` 의 TRIMS), 감상이 아닌
 * 7건을 `NOT_A_REVIEW` 로 지목한 뒤, 조건을 **길이 + 화자 귀속**으로 낮췄다. 필터가 느슨해진
 * 만큼 통독이 앞에서 책임진다.
 */
export function usableReview(review: string | null | undefined, id?: string, minLen = 100): boolean {
  if (id && NOT_A_REVIEW.has(id)) return false
  const t = (review ?? '').trim()
  if (t.length < minLen) return false
  if (QUOTED.test(t)) return true          // 직접 인용이 있으면 통과
  return SAID.test(t)
}
