    "srt": "tsx scripts/srt/generate-srt.ts",
    "faction:srt": "tsx scripts/srt/faction-srt.ts",
    "youtube:auth": "tsx scripts/youtube/youtube-upload.ts auth",
    "youtube:upload": "tsx scripts/youtube/youtube-upload.ts upload",
    "youtube:patch-meta": "tsx scripts/youtube/youtube-upload.ts patch-meta",
