/**
 * 감상 한 건이 글에 실릴 자격이 있는지 본다.
 *
 * 26.09.05에 112건을 통독하며 걸러야 할 두 부류를 알았다.
 *
 *  1. **본인이 말한 근거가 없는 것.** 「톰 크루즈는 드 니로에게 영향을 받았다」처럼
 *     서술자의 해석만 있고 당사자의 행위가 없다. 「누가 꼽았나」라는 이 채널의 전제를
 *     무너뜨린다.
 *  2. **어디서 나온 말인지 없는 것.** 「에드워드 호퍼는 이 걸작을 높이 평가했다」에는
 *     언제 어디서가 없다.
 *
 * 다만 그물이 과하면 좋은 것까지 걷는다. 처음 만든 판이 타란티노의 팟캐스트 발언과
 * 박찬욱의 상영회 회고를 떨어뜨렸다 — 「선정한」·「10위」·「상영에서 봤다」가 신호에
 * 없었기 때문이다. 그래서 **당사자의 행위**를 넓게 잡고, 인용부호가 들어 있으면 그
 * 자체를 근거로 인정한다.
 *
 * 판정은 기계적이라 완벽하지 않다. 원고를 올리기 전에 사람이 통독하는 절차
 * (`_dump-reviews.mts`)를 대체하지 않는다. 이 필터는 그 부담을 줄이는 그물이다.
 */

/** 당사자가 그 작품을 고르거나 말했다는 신호 */
const SAID = new RegExp([
  // 말하기
  '말했', '말한', '밝혔', '밝힌', '적었', '답했', '평했', '평가', '언급', '강조', '덧붙',
  '시인', '인정', '털어놓', '불렀', '부른다', '짚었', '전했', '썼다', '고백', '설명',
  '주장', '묘사', '극찬', '단언', '아쉬워', '물었', '증언', '감탄', '회상', '회고',
  // 고르기
  '꼽았', '꼽는', '꼽으', '꼽힌', '올렸', '골랐', '선택', '선정', '포함', '등재', '지목',
  '뽑았', '삼았', '추천', '순위', '위에 올', '\\d+위',
  // 본 경험을 1인칭·3인칭으로 남긴 것
  '봤다', '보았다', '관람', '다시 보', '반복해 보', '처음 접했', '처음 봤', '빠져',
].join('|'))

/** 언제 어디서인지를 알려 주는 표지 */
const SOURCE = new RegExp([
  '\\b(19|20)\\d{2}\\b',
  '인터뷰', '자서전', '회고록', '팟캐스트', '방송', '다큐', '칼럼', '에세이', '기고',
  '대담', '좌담', '강연', '목록', '투표', '프로필', '매거진', '매체', '지면',
  'Q&A', 'AMA', 'SNS', '인스타', '트위터', '유튜브', '라디오', '영화제', '상영',
  '시상식', '연재', '저서', '책에서', '수상 소감', '기자회견', '무대인사',
].join('|'))

/** 큰따옴표·낫표 안의 발언은 그 자체로 근거다 */
const QUOTED = /["“”][^"“”]{12,}["“”]|'[^']{12,}'/

export function usableReview(review: string | null | undefined, minLen = 100): boolean {
  const t = (review ?? '').trim()
  if (t.length < minLen) return false
  if (QUOTED.test(t)) return true          // 직접 인용이 있으면 통과
  return SAID.test(t) && SOURCE.test(t)
}
