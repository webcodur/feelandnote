{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebSearch(*)",
      "WebFetch(*)",
      "Task(*)",
      "mcp__supabase__*",
      "mcp__google-search-console__list_sites",
      "mcp__google-search-console__list_sitemaps",
      "mcp__google-search-console__search_analytics",
      "mcp__google-search-console__index_inspect",
      "mcp__google-analytics__get_ga4_data"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "supabase",
    "google-analytics",
    "google-search-console"
  ],
  "teammateMode": "tmux"
}
