{
  "name": "@feelandnote/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next dev --turbopack --disable-source-maps",
    "build": "next build --webpack && node scripts/check-standalone-runtime.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:egress": "node scripts/check-egress-patterns.mjs",
    "test:seo-infra": "tsx --test src/lib/seoImageOrigin.test.ts src/lib/sitemap.test.ts src/middleware.test.ts",
    "test:render-mode": "tsx --test src/lib/render-mode.test.ts",
    "check:timeline-scroll": "node scripts/check-celeb-timeline-scroll.mjs",
    "check:content-expand-scroll": "node scripts/check-content-expand-scroll.mjs",
    "check:memory-audio": "node scripts/check-memory-match-audio.mjs",
    "celeb:qid": "node --env-file=.env scripts/bulk-qid.mjs",
    "avatar:prune-old": "node scripts/delete-old-avatars.mjs",
    "sync:bestsellers": "node scripts/sync-bestsellers.mjs",
    "stats:celeb-views": "node scripts/ga4-celeb-views.mjs",
    "icons:app": "node scripts/generate-app-icons.mjs",
    "icons:android": "node scripts/generate-android-launcher-icons.mjs",
    "test:memory-audio": "tsx --test src/components/features/game/memory/audioPlan.test.ts",
    "test:memory-selection": "tsx --test src/components/features/game/memory/selection.test.ts",
    "test:globe": "tsx --test src/components/shared/WorldGlobe/globeSpin.test.ts",
    "test:content-expand": "tsx --test src/components/features/user/contentLibrary/expand/*.test.ts",
    "test:content-locale": "tsx --test src/lib/utils/content-locale-text.test.ts",
    "test:creator-names": "tsx --test src/lib/utils/creator-names.test.ts",
    "test:relation-map": "tsx --test src/lib/celeb/influenceChains.test.ts src/lib/celeb/relationShapes.test.ts src/lib/celeb/relationNeighborhood.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.997.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@feelandnote/ai-services": "workspace:*",
    "@feelandnote/content-search": "workspace:*",
    "@feelandnote/influence-constants": "workspace:*",
    "@feelandnote/shared": "workspace:*",
    "@google/genai": "^1.44.0",
    "@next/third-parties": "^16.1.6",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/typography": "^0.5.19",
    "abcjs": "^6.6.2",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.555.0",
    "next": "16.1.1",
    "next-intl": "^4.8.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.5.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0",
    "topojson-client": "^3.1.0",
    "uuid": "^13.0.0",
    "world-atlas": "2.0.2"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.2.4",
    "@img/sharp-linux-x64": "0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/uuid": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.5.6",
    "puppeteer": "^24.2.1",
    "styled-jsx": "^5.1.7",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3"
  }
}
