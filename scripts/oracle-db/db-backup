#!/usr/bin/env bash
set -euo pipefail
umask 077
exec 9>/run/lock/feelandnote-db-backup.lock
flock -n 9 || { echo 'A database backup is already running.' >&2; exit 1; }
work_dir=$(mktemp -d /var/tmp/feelandnote-db-backup.XXXXXX)
cleanup() {
  find "$work_dir" -type f -exec shred -u {} + 2>/dev/null || true
  rm -rf -- "$work_dir"
}
trap cleanup EXIT
set -a
source /etc/feelandnote/db-backup.env
set +a
recipient=$(tr -d '\r\n' < /etc/feelandnote/db-backup-recipient)
[[ "$recipient" == age1* ]] || { echo 'Invalid age recipient.' >&2; exit 1; }
python3 /usr/local/libexec/feelandnote-db-snapshot.py "$work_dir/snapshot" "${BACKUP_DB_CONTAINER:-feelandnote-db}"
stamp=$(date -u +%Y-%m-%dT%H%M%SZ)
archive="$work_dir/feelandnote-db-$stamp.tar.gz"
tar -C "$work_dir/snapshot" -czf "$archive" .
age -r "$recipient" -o "$archive.age" "$archive"
shred -u "$archive"
export RCLONE_CONFIG_BACKUP_TYPE=s3
export RCLONE_CONFIG_BACKUP_PROVIDER=Cloudflare
export RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID"
export RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY"
export RCLONE_CONFIG_BACKUP_ENDPOINT="https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com"
object_key="postgres/daily/$(basename "$archive.age")"
local_hash=$(sha256sum "$archive.age" | cut -d' ' -f1)
rclone copyto "$archive.age" "backup:$BACKUP_BUCKET/$object_key" --no-traverse
remote_hash=$(rclone cat "backup:$BACKUP_BUCKET/$object_key" | sha256sum | cut -d' ' -f1)
[[ "$local_hash" == "$remote_hash" ]] || { echo 'R2 round-trip SHA256 mismatch.' >&2; exit 1; }
install -d -m 700 /var/lib/feelandnote
install -m 600 "$archive.age" /var/lib/feelandnote/db-last-backup.age
printf '{"object_key":"%s","sha256":"%s","r2_round_trip_verified":true}\n' "$object_key" "$local_hash"
