#!/usr/bin/env bash
# Feel&Note DB 전환: 옛 Micro VM(152.67.216.40) → 새 A1 VM(152.67.198.197)
# 실행:   bash "<이 파일>"
# 롤백:   bash "<이 파일>" rollback   (옛 VM 쓰기 동결 해제 + 옛 터널 재기동 + 새 터널 정지)
# 중간에 실패하면 옛 VM이 읽기 전용으로 남고 터널은 옛 VM 그대로다. 그때는 rollback을 실행한다.
set -euo pipefail
KEY=~/.ssh/feelandnote_oracle
OLD=ubuntu@152.67.216.40
NEW=ubuntu@152.67.198.197
SSH="ssh -i $KEY -o BatchMode=yes -o ConnectTimeout=20"
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
DUMP=/var/tmp/feelandnote-cutover-$STAMP
log() { echo; echo "[$(date +%H:%M:%S)] $*"; }

if [[ "${1:-}" == rollback ]]; then
  log "롤백: 새 터널 정지 → 옛 VM 쓰기 동결 해제 → 옛 터널 재기동"
  $SSH $NEW 'sudo systemctl disable --now cloudflared-feelandnote-db >/dev/null 2>&1; echo "새 터널 정지"'
  $SSH $OLD 'sudo bash -s' <<'R'
q() { docker exec supabase-db psql -X -qAt -U supabase_admin -d postgres -c "$1"; }
q "alter role authenticator reset default_transaction_read_only"
q "alter role supabase_auth_admin reset default_transaction_read_only"
q "select count(pg_terminate_backend(pid)) from pg_stat_activity where usename in ('authenticator','supabase_auth_admin') and pid <> pg_backend_pid()" >/dev/null
sudo systemctl enable --now cloudflared-feelandnote-db >/dev/null 2>&1
sudo systemctl enable --now feelandnote-db-backup.timer >/dev/null 2>&1
echo "옛 VM 쓰기 해제·터널 $(systemctl is-active cloudflared-feelandnote-db)"
R
  exit 0
fi

log "0) 새 VM 준비 상태"
$SSH $NEW 'n=$(docker ps --format "{{.Names}} {{.Status}}" | grep -c healthy); echo "새 VM healthy 컨테이너 $n개"; test "$n" -ge 4; test -x /usr/local/sbin/feelandnote-db-restore-fresh; systemctl is-active cloudflared-feelandnote-db >/dev/null 2>&1 && { echo "새 터널이 이미 켜져 있다. 중단."; exit 1; } || echo "새 터널 꺼짐 확인"'

log "0b) 새 VM Envoy rest 헬스체크 포트를 3001(/ready)로 고정"
$SSH $NEW 'sudo bash -s' <<'E'
set -e
d=/opt/feelandnote/supabase/volumes/api/envoy
python3 - "$d/cds.yaml" <<'PY'
import sys,re,pathlib
p=pathlib.Path(sys.argv[1]); s=p.read_text()
m=re.search(r"(    name: rest\n.*?)(?=\n  - '@type')", s, re.S); blk=m.group(1)
old_ep="                  socket_address:\n                    address: rest\n                    port_value: 3000\n"
if "health_check_config" in blk:
    print("이미 반영됨"); sys.exit(0)
assert blk.count(old_ep)==1
new_ep=old_ep+"                # STRICT_DNS 클러스터는 헬스체크 포트를 엔드포인트에 적는다(alt_port는 무시된다).\n                health_check_config:\n                  port_value: 3001\n"
blk2=blk.replace(old_ep,new_ep).replace("        alt_port: 3001\n","")
p.with_suffix('.yaml.new').write_text(s.replace(blk,blk2)); print("cds.yaml 준비")
PY
[[ -f "$d/cds.yaml.new" ]] && mv "$d/cds.yaml.new" "$d/cds.yaml"
sleep 12
epid=$(docker inspect supabase-envoy --format '{{.State.Pid}}')
nsenter -t $epid -n curl -s -m 5 http://127.0.0.1:9901/stats | grep -E "^(cluster_manager\.cds\.update_rejected|cluster\.rest\.(membership_healthy|health_check\.(success|failure))):" | tr '\n' ' '; echo
E

log "1) 옛 VM 쓰기 동결 (읽기는 계속된다)"
$SSH $OLD 'sudo bash -s' <<'F'
set -e
q() { docker exec supabase-db psql -X -qAt -U supabase_admin -d postgres -c "$1"; }
q "alter role authenticator set default_transaction_read_only = on"
q "alter role supabase_auth_admin set default_transaction_read_only = on"
q "select count(pg_terminate_backend(pid)) from pg_stat_activity where usename in ('authenticator','supabase_auth_admin') and pid <> pg_backend_pid()" >/dev/null
sleep 3
pw=$(grep -oE '^POSTGRES_PASSWORD=.*' /opt/feelandnote/supabase/.env | cut -d= -f2-)
echo "authenticator 새 세션 read_only = $(docker exec -e PGPASSWORD="$pw" supabase-db psql -X -qAt -h localhost -U authenticator -d postgres -c 'show default_transaction_read_only')"
key=$(grep -oE '^SUPABASE_PUBLISHABLE_KEY=.*' /opt/feelandnote/supabase/.env | cut -d= -f2-)
curl -s -o /dev/null -m 10 -w '옛 REST 읽기 HTTP %{http_code}\n' "http://127.0.0.1:8000/rest/v1/celebs?select=slug&limit=1" -H "apikey: $key"
echo "동결 시각 $(date -u +%FT%TZ)"
F

log "2) 옛 VM 평문 덤프 (4~6분)"
$SSH $OLD "sudo /usr/local/sbin/feelandnote-db-dump-plain $DUMP"

log "3) 덤프 전송 옛 → 새"
$SSH $OLD "sudo tar czf - -C /var/tmp $(basename "$DUMP")" | $SSH $NEW "sudo tar xzf - -C /var/tmp && sudo ls -la $DUMP"
$SSH $OLD "sudo rm -rf $DUMP"

log "4) 새 VM 초기화·복원·검증 (약 3분)"
$SSH $NEW "sudo /usr/local/sbin/feelandnote-db-restore-fresh $DUMP && sudo rm -rf $DUMP"

log "5) 새 VM 역할 읽기 전용 해제·REST 확인"
$SSH $NEW 'sudo bash -s' <<'N'
set -e
q() { docker exec supabase-db psql -X -qAt -U supabase_admin -d postgres -c "$1"; }
q "alter role authenticator reset default_transaction_read_only"
q "alter role supabase_auth_admin reset default_transaction_read_only"
q "select count(pg_terminate_backend(pid)) from pg_stat_activity where usename in ('authenticator','supabase_auth_admin') and pid <> pg_backend_pid()" >/dev/null
sleep 3
q "select rolname||' : '||coalesce(array_to_string(rolconfig,','),'-') from pg_roles where rolname in ('authenticator','supabase_auth_admin')"
key=$(grep -oE '^SUPABASE_PUBLISHABLE_KEY=.*' /opt/feelandnote/supabase/.env | cut -d= -f2-)
for _ in 1 2 3 4 5 6; do code=$(curl -s -o /dev/null -m 10 -w '%{http_code}' "http://127.0.0.1:8000/rest/v1/celebs?select=slug&limit=1" -H "apikey: $key"); [[ "$code" == 200 ]] && break; sleep 3; done
echo "새 REST 읽기 HTTP $code"; test "$code" == 200
N

log "6) 터널 전환: 옛 정지 → 새 기동 (여기서 10~20초 끊긴다)"
$SSH $OLD 'sudo systemctl disable --now cloudflared-feelandnote-db >/dev/null 2>&1; echo "옛 터널 정지 $(date -u +%T)"'
$SSH $NEW 'sudo systemctl enable --now cloudflared-feelandnote-db >/dev/null 2>&1; sleep 8; echo "새 터널 $(systemctl is-active cloudflared-feelandnote-db) $(date -u +%T)"; sudo journalctl -u cloudflared-feelandnote-db --since "-2min" --no-pager -o cat | grep -iE "registered|connIndex" | tail -3'

log "7) 공개 경로 확인"
key=$($SSH $NEW "sudo grep -oE '^SUPABASE_PUBLISHABLE_KEY=.*' /opt/feelandnote/supabase/.env | cut -d= -f2-")
for _ in 1 2 3 4 5 6 7 8; do code=$(curl -s -o /dev/null -m 15 -w '%{http_code}' "https://db.feelandnote.com/rest/v1/celebs?select=slug&limit=1" -H "apikey: $key"); echo "db.feelandnote.com REST HTTP $code $(date -u +%T)"; [[ "$code" == 200 ]] && break; sleep 5; done
test "$code" == 200
for u in https://feelandnote.com/celeb/barack-obama https://feelandnote.com/library/curated/yonsei-university https://feelandnote.com/; do
  curl -s -o /dev/null -m 40 -w "$u HTTP %{http_code} %{time_total}s\n" -H "Accept: text/html" -H "Cache-Control: no-cache" "$u"
done

log "8) 백업 타이머: 새 VM 켜고 옛 VM 끈다"
$SSH $NEW 'sudo systemctl enable --now feelandnote-db-backup.timer >/dev/null 2>&1; systemctl list-timers feelandnote-db-backup.timer --no-pager | sed -n 2p'
$SSH $OLD 'sudo systemctl disable --now feelandnote-db-backup.timer >/dev/null 2>&1; echo "옛 백업 타이머 정지"'

log "전환 완료. 옛 VM 컨테이너는 롤백용으로 그대로 둔다(터널·백업 타이머만 정지)."
