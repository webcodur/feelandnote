{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "blocking",
    "major",
    "minor",
    "strengths"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "revise",
        "hold"
      ]
    },
    "blocking": {
      "$ref": "#/$defs/issues"
    },
    "major": {
      "$ref": "#/$defs/issues"
    },
    "minor": {
      "$ref": "#/$defs/issues"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "evidence",
          "fix"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    }
  }
}
