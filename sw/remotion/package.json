{
  "name": "@feelandnote/remotion",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "reboot": "node scripts/dev.mjs --restart",
    "studio": "remotion studio",
    "voice": "tsx scripts/generate-voice.ts",
    "voice:list": "tsx scripts/generate-voice.ts --list",
    "voice:profile": "tsx scripts/generate-voice-profile.ts",
    "voice:labels": "tsx scripts/generate-common-labels.ts",
    "voice:upload": "tsx scripts/voice-r2.ts upload",
    "voice:pull": "tsx scripts/voice-r2.ts pull",
    "voice:r2": "tsx scripts/voice-r2.ts",
    "analyze": "tsx scripts/analyze-voice.ts",
    "render": "remotion render --image-format=png --gl=angle",
    "render:short": "remotion render BookRecommendShort",
    "render:all": "tsx scripts/render-all.ts",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/genai": "^1.44.0",
    "@remotion/cli": "4.0.434",
    "@remotion/media-utils": "4.0.434",
    "@remotion/player": "4.0.434",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.434",
    "wav": "^1.0.2"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.997.0",
    "@hono/node-server": "^1.19.11",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "hono": "^4.12.8",
    "mp3-duration": "^1.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
