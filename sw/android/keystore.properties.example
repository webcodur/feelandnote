# 파일명: /sw/android/keystore.properties.example
# 기능: 서명 설정 견본
# 책임: 릴리스 서명에 필요한 값의 이름을 알려 준다.
#
# 사용법: 이 파일을 keystore.properties 로 복사해 실제 값을 채운다.
# 🔴 keystore.properties 와 .jks 파일은 저장소에 올리지 않는다(.gitignore 에 걸려 있다).
#    잃어버리면 같은 앱으로 갱신할 수 없다. 안전한 곳에 따로 보관하라.

storeFile=../feelandnote-release.jks
storePassword=
keyAlias=feelandnote
keyPassword=
